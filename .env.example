# beCPG Community images, built by scripts/build-images.sh when not found.
BECPG_IMAGE_REGISTRY=becpg-community
BECPG_VERSION=local

# Ports published on the host.
BECPG_PORT=8080
SHARE_PORT=8180

# Used by the seed script, the dashboard and Claude Code. Local development values only.
BECPG_URL=http://localhost:8080/alfresco
BECPG_USER=admin
BECPG_PASSWORD=becpg
SHARE_URL=http://localhost:8180/share

# Claude, for the product assistant of the app and the command line agent.
# Uncomment and set your key (https://platform.claude.com), or log in with the ant CLI.
# ANTHROPIC_API_KEY=sk-ant-...
